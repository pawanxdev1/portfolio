# --- Backend (used by /api serverless functions, set these in Vercel Project Settings) ---
MONGODB_URI=your_mongodb_atlas_connection_string
MONGO_DB_NAME=portfolio

# Optional: restrict CORS to your deployed domain in production
CLIENT_ORIGIN=https://your-portfolio.vercel.app

# --- Frontend (set in client/.env, must be prefixed with VITE_) ---
VITE_API_URL=/api
